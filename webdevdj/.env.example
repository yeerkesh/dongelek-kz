# Settings for the HOSTING. On your laptop you do not need any of this.
# Copy the lines to the "environment variables" page of your hosting.
# NEVER put real values into Git.

DJANGO_ENV=production

# Generate a new key:  python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=

# Your domain(s), comma separated
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com

# Only if the site and the API are on different addresses:
# DJANGO_CORS_ORIGINS=https://yourname.github.io
# DJANGO_CSRF_ORIGINS=https://yourname.pythonanywhere.com

# 1 if the hosting puts a proxy in front of Django (most hostings do)
DJANGO_BEHIND_PROXY=1
DJANGO_NUM_PROXIES=1

# Optional: move the Django admin to a secret address
# DJANGO_ADMIN_URL=my-secret-admin-url/
